# ─────────────────────────────────────────────────────────────
# LiveRound — never commit real secrets
# Copy to `.env.local` (Next.js) and Vercel project env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
AUTH_SECRET=replace-with-32-plus-random-chars
AUTH_URL=http://localhost:3000
AUTH_DEV_LOGIN=true

# Neon Postgres (required on Vercel; optional locally — memory fallback)
DATABASE_URL=

# Auth.js — Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email (optional in development; required in production for email sign-in)
RESEND_API_KEY=
EMAIL_FROM=LiveRound <noreply@localhost>

# Anthropic — drafts, scoring, Think for me. Heuristic fallback if empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Reddit official API (application-only OAuth). Descriptive User-Agent required.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=LiveRound/0.1 (by /u/yourhandle)
REDDIT_REDIRECT_URI=http://localhost:3000/api/oauth/reddit/callback

# X OAuth — if empty, MockXAdapter stays on and Settings shows a banner.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
X_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# AES-256-GCM for social OAuth tokens at rest (32 bytes, base64)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Stripe — catalog renders without keys; checkout is disabled until set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SCOUT_MONTH=
STRIPE_PRICE_SCOUT_YEAR=
STRIPE_PRICE_HUNTER_MONTH=
STRIPE_PRICE_HUNTER_YEAR=
STRIPE_PRICE_APEX_MONTH=
STRIPE_PRICE_APEX_YEAR=
STRIPE_PRICE_PACK_50=
STRIPE_PRICE_PACK_200=
STRIPE_PRICE_PACK_500=
STRIPE_PRICE_PACK_1800=

# Protects /api/cron/* (Vercel cron header also accepted)
CRON_SECRET=

# Sentry (optional)
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
# Legacy X Intelligence Engine (Cloudflare Workers) — unused by LiveRound
# ─────────────────────────────────────────────────────────────
APP_ENV=development
WEB_ORIGIN=http://localhost:5173
AUTH_MODE=development
X_BEARER_TOKEN=
ANTHROPIC_API_KEY=
